<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var accordionButtons = document.querySelectorAll('.card-header-button');
    accordionButtons.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var targetId = this.getAttribute('data-target');
        if(!targetId && this.getAttribute('href') && this.getAttribute('href').startsWith('#')) {
            targetId = this.getAttribute('href');
        }
        if(!targetId) return;
        var targetPanel = document.querySelector(targetId);
        var wrapper = this.closest('.card-wrapper');
        if (targetPanel && wrapper) {
          if (targetPanel.style.display === 'none' || targetPanel.style.display === '') {
            targetPanel.style.display = 'block';
            wrapper.classList.add('expand');
            this.setAttribute('aria-expanded', 'true');
          } else {
            targetPanel.style.display = 'none';
            wrapper.classList.remove('expand');
            this.setAttribute('aria-expanded', 'false');
          }
        }
      });
    });

    // Handler for default Elementor Accordions
    var elementorAccordions = document.querySelectorAll('.elementor-tab-title');
    elementorAccordions.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var targetId = this.getAttribute('aria-controls');
        if(!targetId) return;
        var targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          if (targetPanel.style.display === 'none' || targetPanel.style.display === '') {
            // Close all others in the same accordion group
            var parent = this.closest('.elementor-accordion');
            if(parent) {
                var activeTitles = parent.querySelectorAll('.elementor-tab-title.elementor-active');
                var activePanels = parent.querySelectorAll('.elementor-tab-content.elementor-active');
                activeTitles.forEach(t => { t.classList.remove('elementor-active'); t.setAttribute('aria-expanded', 'false'); });
                activePanels.forEach(p => { p.classList.remove('elementor-active'); p.style.display = 'none'; });
            }
            
            targetPanel.style.display = 'block';
            targetPanel.classList.add('elementor-active');
            this.classList.add('elementor-active');
            this.setAttribute('aria-expanded', 'true');
          } else {
            targetPanel.style.display = 'none';
            targetPanel.classList.remove('elementor-active');
            this.classList.remove('elementor-active');
            this.setAttribute('aria-expanded', 'false');
          }
        }
      });
    });
  });
</script>
