<div class="elementor-shortcode">    <style>
.ele-slider-6a87c8eae2b06 {
position: relative;
width: 100%;
max-width: 100%;
overflow: hidden;
touch-action: pan-y; /* Permite scroll vertical nativo, bloquea horizontal */
-webkit-tap-highlight-color: transparent;
}
.ele-slider-6a87c8eae2b06 .ele-slider-wrapper {
display: flex;
transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
will-change: transform;
}
.ele-slider-6a87c8eae2b06 .ele-slide {
flex: 0 0 100%;
min-width: 100%;
width: 100%;
box-sizing: border-box;
/* Forzar a Elementor a respetar el ancho del contenedor */
max-width: 100vw;
}
/* Asegurar que las secciones internas de Elementor no rompan el layout */
.ele-slider-6a87c8eae2b06 .ele-slide .elementor-section {
max-width: 100% !important;
left: 0 !important;
}
.ele-slider-6a87c8eae2b06 .ele-slide .elementor-container {
max-width: 100% !important;
}
.ele-slider-6a87c8eae2b06 .ele-slide img,
.ele-slider-6a87c8eae2b06 .ele-slide video {
max-width: 100%;
height: auto;
}
/* Flechas */
.ele-slider-6a87c8eae2b06 .ele-arrow {
position: absolute;
top: 50%;
transform: translateY(-50%);
z-index: 10;
background: rgba(0,0,0,0.5);
color: #fff;
border: none;
width: 44px;
height: 44px;
cursor: pointer;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
font-size: 18px;
transition: background 0.3s;
-webkit-appearance: none;
}
.ele-slider-6a87c8eae2b06 .ele-arrow:hover {
background: rgba(0,0,0,0.8);
}
.ele-slider-6a87c8eae2b06 .ele-arrow.prev { left: 10px; }
.ele-slider-6a87c8eae2b06 .ele-arrow.next { right: 10px; }
/* Dots */
.ele-slider-6a87c8eae2b06 .ele-dots {
display: flex;
justify-content: center;
gap: 8px;
margin-top: 15px;
position: relative;
z-index: 10;
}
.ele-slider-6a87c8eae2b06 .ele-dot {
width: 12px;
height: 12px;
border-radius: 50%;
border: 2px solid rgba(0,0,0,0.3);
background: transparent;
cursor: pointer;
padding: 0;
transition: all 0.3s;
-webkit-appearance: none;
}
.ele-slider-6a87c8eae2b06 .ele-dot.active {
background: rgba(0,0,0,0.7);
border-color: rgba(0,0,0,0.7);
}
/* Móvil: flechas más grandes y accesibles */
@media (max-width: 768px) {
.ele-slider-6a87c8eae2b06 .ele-arrow {
width: 48px;
height: 48px;
font-size: 20px;
}
.ele-slider-6a87c8eae2b06 .ele-arrow.prev { left: 5px; }
.ele-slider-6a87c8eae2b06 .ele-arrow.next { right: 5px; }
}
</style>
