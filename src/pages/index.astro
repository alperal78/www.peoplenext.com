import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout 
  title="Gold Partner de SAP SuccessFactors - PeopleNext"
  description="Mejora la experiencia de tus empleados y optimiza procesos de RH y Capital Humano con PeopleNext Gold Partner de SAP SuccessFactors en México."
