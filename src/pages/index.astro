<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
(function() {
const slider = document.querySelector('.ele-slider-6a87c8eae2b06');
if (!slider) return;
const wrapper = slider.querySelector('.ele-slider-wrapper');
const slides = slider.querySelectorAll('.ele-slide');
const prevBtn = slider.querySelector('.ele-arrow.prev');
const nextBtn = slider.querySelector('.ele-arrow.next');
const dots = slider.querySelectorAll('.ele-dot');
const autoplayDelay = parseInt(slider.dataset.autoplay) || 0;
if (slides.length <= 1) return;
let currentIndex = 0;
let autoPlayInterval;
let touchStartX = 0;
let touchEndX = 0;
let isDragging = false;
function goTo(index) {
if (index < 0) index = slides.length - 1;
if (index >= slides.length) index = 0;
currentIndex = index;
wrapper.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
dots.forEach((dot, i) => {
dot.classList.toggle('active', i === currentIndex);
});
}
function next() { goTo(currentIndex + 1); }
function prev() { goTo(currentIndex - 1); }
function startAutoPlay() {
if (autoplayDelay > 0) {
autoPlayInterval = setInterval(next, autoplayDelay);
}
}
function stopAutoPlay() {
clearInterval(autoPlayInterval);
}
function resetAutoPlay() {
stopAutoPlay();
startAutoPlay();
}
// Eventos de flechas
if (nextBtn) nextBtn.addEventListener('click', () => { next(); resetAutoPlay(); });
if (prevBtn) prevBtn.addEventListener('click', () => { prev(); resetAutoPlay(); });
// Eventos de dots
dots.forEach(dot => {
dot.addEventListener('click', () => {
goTo(parseInt(dot.dataset.index));
resetAutoPlay();
});
});
// Swipe táctil real
slider.addEventListener('touchstart', function(e) {
touchStartX = e.changedTouches[0].screenX;
isDragging = true;
stopAutoPlay();
}, { passive: true });
slider.addEventListener('touchmove', function(e) {
if (!isDragging) return;
touchEndX = e.changedTouches[0].screenX;
}, { passive: true });
slider.addEventListener('touchend', function(e) {
if (!isDragging) return;
isDragging = false;
const diff = touchStartX - touchEndX;
const threshold = 50; // mínimo px para considerar swipe
if (Math.abs(diff) > threshold) {
if (diff > 0) {
next(); // swipe izquierda -> siguiente
} else {
prev(); // swipe derecha -> anterior
}
